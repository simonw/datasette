+@pytest.mark.asyncio
+@pytest.mark.parametrize("size", [0, 10, 65536, 1024 * 1024, 1024 * 1024 + 1, 3000000])
+async def test_asgi_send_file(tmp_path, size):
+    from datasette.utils.asgi import asgi_send_file
+
+    path = tmp_path / "file.bin"
+    content = (bytes(range(256)) * (size // 256 + 1))[:size]
+    path.write_bytes(content)
+    messages = []
+
+    async def send(message):
+        messages.append(message)
+
+    await asgi_send_file(send, path, headers={"x-test": "1"})
+    start, *body_messages = messages
+    assert start["status"] == 200
+    assert dict(start["headers"]) == {
+        b"x-test": b"1",
+        b"content-length": str(size).encode(),
+        b"content-type": b"application/octet-stream",
+    }
+    assert b"".join(m["body"] for m in body_messages) == content
+    assert not body_messages[-1].get("more_body")
+    assert all(m.get("more_body") for m in body_messages[:-1])
