+            "path": "/-/raw-headers",
+            "raw_path": b"/-/raw-headers",
+            "query_string": query_string.encode("latin-1"),
+            "root_path": "",
+            "headers": [(b"host", b"localhost")]
+            + [
+                (name.encode("latin-1"), value.encode("latin-1"))
+                for name, value in request_headers
+            ],
+        },
+        receive,
+        send,
+    )
+    # Ignore headers added by asgi_wrapper() plugins registered by other tests
+    return [
+        (name.decode("latin-1"), value.decode("latin-1"))
+        for name, value in messages[0]["headers"]
+        if name.lower() in RELEVANT_HEADERS
+    ]
+
+
+RELEVANT_HEADERS = {b"content-type", b"cache-control", b"vary", b"set-cookie", b"x-a"}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "request_headers,response_headers,expected",
+    (
+        # Anonymous: cache-control is kept, vary gains Cookie and Authorization
+        (
+            [],
+            ["content-type:text/plain", "Cache-Control:max-age=5"],
+            [
+                ("content-type", "text/plain"),
+                ("Cache-Control", "max-age=5"),
+                ("vary", "Cookie, Authorization"),
+            ],
+        ),
+        # Existing vary headers are merged, de-duplicated case-insensitively
+        (
+            [],
+            ["Vary:Accept, cookie", "x-a:1", "VARY: authorization ,, Origin "],
+            [("x-a", "1"), ("vary", "Accept, cookie, authorization, Origin")],
+        ),
+        (
+            [],
+            ["Vary:*", "x-a:1"],
+            [("x-a", "1"), ("vary", "*")],
+        ),
+        # Cookie or Authorization request headers make the response private
+        (
+            [("cookie", "")],
+            ["Cache-Control:max-age=5", "x-a:1", "cache-control:public"],
+            [
+                ("x-a", "1"),
+                ("cache-control", "private, no-store"),
+                ("vary", "Cookie, Authorization"),
+            ],
+        ),
+        (
+            [("Authorization", "Basic eDp5")],
+            ["x-a:1"],
+            [
+                ("x-a", "1"),
+                ("cache-control", "private, no-store"),
+                ("vary", "Cookie, Authorization"),
+            ],
+        ),
+        # So does setting a cookie, wherever the set-cookie header appears
+        (
+            [],
+            ["Cache-Control:max-age=5", "Vary:Accept", "Set-Cookie:a=b"],
+            [
+                ("Set-Cookie", "a=b"),
+                ("cache-control", "private, no-store"),
+                ("vary", "Accept, Cookie, Authorization"),
+            ],
+        ),
+    ),
+)
+async def test_response_privacy_headers(
+    ds_raw_headers, request_headers, response_headers, expected
+):
+    assert (
+        await _response_headers(ds_raw_headers, response_headers, request_headers)
+        == expected
+    )
