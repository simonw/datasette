+def test_cached_sha256_file(tmp_path):
+    path = tmp_path / "test.txt"
+    path.write_text("hello")
+    assert utils.cached_sha256_file(path) == hashlib.sha256(b"hello").hexdigest()
+    key, _ = utils._sha256_cache[path]
+    utils._sha256_cache[path] = (key, "cached")
+    assert utils.cached_sha256_file(path) == "cached"
+    # Modifying the file invalidates the cached hash
+    path.write_text("hello!")
+    assert utils.cached_sha256_file(path) == hashlib.sha256(b"hello!").hexdigest()
+    utils._sha256_cache.clear()
+
