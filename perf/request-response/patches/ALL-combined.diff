+    (tmp_path / "small.txt").write_text("one")
+    (tmp_path / "large.txt").write_text("a large file")
+    ds = Datasette(static_mounts=[("assets", str(tmp_path))])
+    for filename, before, after in (
+        ("small.txt", "one", "three"),
+        ("large.txt", "a large file", "a larger file"),
