     def _versions(self):
+        # Probing SQLite (opening a connection, running every
+        # prepare_connection hook, creating FTS virtual tables) is slow and
+        # the answer only changes if the configured extensions, the
+        # registered prepare_connection hooks or the version note change.
+        cache_key = (
+            tuple(self.sqlite_extensions),
+            tuple(pm.hook.prepare_connection.get_hookimpls()),
+            self.version_note,
+        )
+        cached = self._versions_cache
+        if cached is None or cached[0] != cache_key:
+            cached = (cache_key, self._versions_uncached())
+            self._versions_cache = cached
+        return copy.deepcopy(cached[1])
+
