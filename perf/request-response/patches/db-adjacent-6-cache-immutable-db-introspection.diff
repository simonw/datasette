+    async def _cached_if_immutable(self, key, compute):
+        # Schema introspection results for immutable databases cannot go
+        # stale, so cache them rather than making a thread-pool round trip.
+        # Only names that exist in the schema are cached, so table names
+        # taken from the URL (e.g. ?_through=) cannot grow the cache.
+        if not self._schema_is_immutable:
+            return await compute()
+        self._check_not_closed()
