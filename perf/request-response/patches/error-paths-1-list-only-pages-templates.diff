+def test_list_page_templates_matches_list_templates(custom_pages_client):
+    # The 404 handler only walks pages/ directories - check that finds the
+    # same templates, in the same order, as filtering list_templates()
+    environment = custom_pages_client.ds.get_jinja_environment()
+    expected = [
+        name for name in environment.list_templates() if name.startswith("pages/")
+    ]
+    assert "pages/topic_{topic}/{slug}.html" in expected
+    assert _list_page_templates(environment.loader) == expected
