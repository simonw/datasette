+def _list_page_templates(loader):
+    """
+    Same as [t for t in loader.list_templates() if t.startswith("pages/")]
+    but for Jinja's built-in loaders only walks the pages/ directories,
+    not every template directory - this runs on every 404
+    """
+    if type(loader) is ChoiceLoader:
+        found = set()
+        for child in loader.loaders:
+            found.update(_list_page_templates(child))
+        return sorted(found)
+    if type(loader) is FileSystemLoader:
+        found = set()
+        for searchpath in loader.searchpath:
+            pages_dir = os.path.join(searchpath, "pages")
+            # os.walk(searchpath) only descends into a symlink if followlinks
+            if not loader.followlinks and os.path.islink(pages_dir):
+                continue
+            pages_loader = FileSystemLoader(pages_dir, followlinks=loader.followlinks)
+            found.update("pages/" + name for name in pages_loader.list_templates())
+        return sorted(found)
+    if type(loader) is PrefixLoader:
+        found = []
+        for prefix, child in loader.mapping.items():
+            start = prefix + loader.delimiter
+            # Skip loaders whose prefix means no name can start with pages/
+            if start.startswith("pages/") or "pages/".startswith(start):
+                found.extend(
+                    start + name
+                    for name in child.list_templates()
+                    if (start + name).startswith("pages/")
+                )
+        return found
+    return [name for name in loader.list_templates() if name.startswith("pages/")]
+
+
 _curly_re = re.compile(r"({.*?})")
 
 
