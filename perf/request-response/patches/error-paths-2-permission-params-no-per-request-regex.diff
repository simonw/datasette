 from datasette.resources import DatabaseResource, QueryResource, TableResource
 
 
+def test_rename_params():
+    from datasette.utils.actions_sql import _rename_params
+
+    sql = "SELECT :reason_12 AS reason, :reason_1 AS r, :reason_12x AS x"
+    assert _rename_params(sql, {"reason_12": "a0_reason_12"}) == (
+        "SELECT :a0_reason_12 AS reason, :reason_1 AS r, :reason_12x AS x"
+    )
+    # Names using other characters fall back to a pattern per name
+    assert _rename_params("SELECT :x$y, :x", {"x$y": "a0_x$y"}) == (
+        "SELECT :a0_x$y, :x"
+    )
+
