@@ -32,6 +32,25 @@ if TYPE_CHECKING:
     from datasette.permissions import Action
 
 
+_param_reference_re = re.compile(r":([A-Za-z0-9_]+)")
+_simple_param_name_re = re.compile(r"[A-Za-z0-9_]+")
+
+
+def _rename_params(sql: str, renames: dict[str, str]) -> str:
+    """Rewrite each :key parameter reference in sql to :renames[key]"""
+    if all(_simple_param_name_re.fullmatch(key) for key in renames):
+        # A single pass with a precompiled pattern - PermissionSQL.allow()
+        # invents a new :reason_N name on every call, so compiling a pattern
+        # per name would miss the re module cache on every request
+        return _param_reference_re.sub(
+            lambda m: ":" + renames.get(m.group(1), m.group(1)), sql
+        )
+    for key, new_key in renames.items():
+        pattern = re.compile(":" + re.escape(key) + r"(?![A-Za-z0-9_])")
+        sql = pattern.sub(":" + new_key, sql)
+    return sql
+
