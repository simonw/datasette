+@pytest.mark.asyncio
+async def test_handle_exception_rich_traceback_only_for_server_errors(
+    ds_client, monkeypatch
+):
+    from datasette import handle_exception
+
+    printed = []
+
+    class FakeConsole:
+        def print_exception(self, **kwargs):
+            printed.append(kwargs)
+
+    class FakeRich:
+        @staticmethod
+        def get_console():
+            return FakeConsole()
+
+    monkeypatch.setattr(handle_exception, "rich", FakeRich)
+    # A NotFound raised by a view, and a path that matches no route at all
+    for path in ("/fixtures/no_such_table", "/fixtures/nope/nope/nope/nope"):
+        response = await ds_client.get(path)
+        assert response.status_code == 404
+    assert printed == []
+    response = await ds_client.get("/trigger-error")
+    assert response.status_code == 500
+    assert printed == [{"show_locals": True}]
+
