@@ -8,6 +9,16 @@ from asyncinject import Registry
 from datasette.utils.asgi import BadRequest
 
 
+def _resolve_extras_in_parallel():
+    # With the GIL, resolving extras concurrently puts several queries on the
+    # SQL thread pool at once, and the workers then contend for the GIL on
+    # every fetched row - measured at 2-5x the CPU of running them one at a
+    # time. On a free-threaded build concurrent queries run in parallel.
+    # Checked when a registry is built, since importing an extension module
+    # without free-threading support can turn the GIL back on.
+    return not getattr(sys, "_is_gil_enabled", lambda: True)()
+
