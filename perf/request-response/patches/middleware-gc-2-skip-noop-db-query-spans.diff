+
+
+def test_start_as_current_span_without_a_provider_keeps_the_current_span(
+    monkeypatch,
+):
+    # The suite installs a provider, so pretend that it has not
+    monkeypatch.setattr(
+        otel_trace, "get_tracer_provider", lambda: otel_trace.ProxyTracerProvider()
+    )
+    assert not tracer_provider_installed()
+    with start_as_current_span("db.query") as span:
+        assert span is otel_trace.INVALID_SPAN
+        assert otel_trace.get_current_span() is otel_trace.INVALID_SPAN
+    # A remote parent stays current, as it would with the no-op tracer
+    remote = NonRecordingSpan(SpanContext(trace_id=1, span_id=2, is_remote=True))
+    token = otel_context_api.attach(otel_trace.set_span_in_context(remote))
+    try:
+        with start_as_current_span("db.query", kind=SpanKind.CLIENT) as span:
+            assert span is remote
+            assert otel_trace.get_current_span() is remote
+    finally:
+        otel_context_api.detach(token)
+
+
+@pytest.mark.asyncio
+async def test_start_as_current_span_with_a_provider_records_spans(otel_spans):
+    assert tracer_provider_installed()
+    otel_spans.clear()
+    with start_as_current_span("test.helper") as span:
+        assert span.is_recording()
+    assert [s.name for s in otel_spans.get_finished_spans()] == ["test.helper"]
