@@ -54,6 +61,31 @@ SCHEMA_URL = "https://opentelemetry.io/schemas/1.29.0"
 tracer = otel_trace.get_tracer("datasette", __version__, schema_url=SCHEMA_URL)
 meter = otel_metrics.get_meter("datasette", __version__, schema_url=SCHEMA_URL)
 
+
+def tracer_provider_installed():
+    """
+    False while no `TracerProvider` has been installed, when every span is a
+    no-op. Check this each time, since a provider can be installed later.
+    """
+    return not isinstance(
+        otel_trace.get_tracer_provider(), otel_trace.ProxyTracerProvider
+    )
+
+
+def start_as_current_span(name, **kwargs):
+    """
+    `tracer.start_as_current_span()`, minus the cost of a no-op span.
+
+    With no provider installed the no-op tracer would make the current
+    `NonRecordingSpan` current again, so that span is used directly.
+    """
+    if "context" not in kwargs and not tracer_provider_installed():
+        span = get_current_span()
+        if isinstance(span, NonRecordingSpan):
+            return nullcontext(span)
+    return tracer.start_as_current_span(name, **kwargs)
+
+
 MAX_SQL_LENGTH = 2048
 
 
