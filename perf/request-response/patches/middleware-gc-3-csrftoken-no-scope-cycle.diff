+class _LegacyCsrfToken:
+    """
+    Returns the same random token every time it is called.
+
+    This keeps the token itself rather than storing it in the scope, since a
+    closure over the scope stored in that scope would be a reference cycle,
+    keeping every request's scope alive until the garbage collector runs.
+    """
+
+    __slots__ = ("token",)
+
+    def __init__(self):
+        self.token = None
+
+    def __call__(self):
+        if self.token is None:
+            self.token = secrets.token_urlsafe(32)
+        return self.token
+
+
