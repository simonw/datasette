+def test_headers_getter_matches_names_case_insensitively():
+    headers = [
+        (b"host", b"localhost"),
+        (b"TraceParent", b"first"),
+        (b"traceparentx", b"not-this"),
+        (b"traceparent", b"second"),
+    ]
+    assert _HEADERS_GETTER.get(headers, "traceparent") == ["first", "second"]
+    assert _HEADERS_GETTER.get(headers, "TRACEPARENT") == ["first", "second"]
+    assert _HEADERS_GETTER.get(headers, "baggage") is None
+    assert _HEADERS_GETTER.get([], "traceparent") is None
