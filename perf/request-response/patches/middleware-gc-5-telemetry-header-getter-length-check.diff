diff --git a/datasette/telemetry.py b/datasette/telemetry.py
index 2fd5a9d..d459738 100644
--- a/datasette/telemetry.py
+++ b/datasette/telemetry.py
@@ -145,7 +145,13 @@ class _ScopeHeadersGetter(Getter):
 
     def get(self, carrier, key):
         wanted = key.lower().encode("latin-1")
-        values = [v.decode("latin-1") for k, v in carrier if k.lower() == wanted]
+        size = len(wanted)
+        # Comparing lengths first avoids lowercasing most header names
+        values = [
+            v.decode("latin-1")
+            for k, v in carrier
+            if len(k) == size and k.lower() == wanted
+        ]
         return values or None
 
     def keys(self, carrier):
