diff --git a/tests/test_tracer.py b/tests/test_tracer.py
index 21cfa95..2afa29e 100644
--- a/tests/test_tracer.py
+++ b/tests/test_tracer.py
@@ -96,3 +96,28 @@ def test_trace_parallel_queries():
     one, two = traces
     # "two" should have started before "one" ended
     assert two["start"] < one["end"]
+
+
+@pytest.mark.asyncio
+async def test_trace_records_only_while_capturing():
+    from datasette.tracer import capture_traces, trace
+
+    # Nothing is capturing, so the keyword arguments are passed straight through
+    with trace("custom", foo=1) as kwargs:
+        assert kwargs == {"foo": 1}
+
+    @trace("decorated", foo=2)
+    def decorated():
+        return "result"
+
+    # A decorated function checks whether traces are being captured each call
+    assert decorated() == "result"
+    traces = []
+    with capture_traces(traces):
+        assert decorated() == "result"
+        with trace("custom", foo=1):
+            pass
+    assert [(t["type"], t["foo"]) for t in traces] == [
+        ("decorated", 2),
+        ("custom", 1),
+    ]
