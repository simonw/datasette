     async def _execute_fn_cached_if_immutable(self, key, fn):
         return await self._cached_if_immutable(key, lambda: self.execute_fn(fn))
 
+    async def prefetch_table_schema(self, table):
+        """Within a request, introspect a table in one thread-pool trip and
+        seed the request-scoped schema memo. Returns (table_exists, view_exists)."""
+        request_cache = _request_schema_cache.get()
+        if self._schema_is_immutable or request_cache is None:
+            return None
+
+        def _prefetch(conn):
+            kind = conn.execute(
+                "select type from sqlite_master where name = ? and type in ('table', 'view')",
+                (table,),
+            ).fetchone()
+            kind = kind[0] if kind else None
+            out = {"kind": kind}
+            if kind is not None:
+                out["table_columns"] = table_columns(conn, table)
+                out["table_column_details"] = table_column_details(conn, table)
+                out["primary_keys"] = detect_primary_keys(conn, table)
+                out["fts_table"] = detect_fts(conn, table)
+                out["foreign_keys_for_table"] = get_outbound_foreign_keys(conn, table)
+            return out
+
+        out = await self.execute_fn(_prefetch)
+        loop = asyncio.get_running_loop()
+        for key in (
+            "table_columns",
+            "table_column_details",
+            "primary_keys",
+            "fts_table",
+            "foreign_keys_for_table",
+        ):
+            if key in out:
+                future = loop.create_future()
+                future.set_result(out[key])
+                request_cache.setdefault((id(self), (key, table)), future)
+        return out["kind"] == "table", out["kind"] == "view"
+
     async def table_exists(self, table):
         if self._schema_is_immutable:
             self._check_not_closed()
