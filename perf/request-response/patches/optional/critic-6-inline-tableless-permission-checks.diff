+_table_free = threading.local()
+
+
+def _table_free_authorizer(action, arg1, arg2, db_name, trigger):
+    # Allow only SELECT and function calls: any read of a real table
+    # (including sqlite_master), pragma or attach must use the internal DB
+    if action in (sqlite3.SQLITE_SELECT, sqlite3.SQLITE_FUNCTION):
+        return sqlite3.SQLITE_OK
+    return sqlite3.SQLITE_DENY
+
+
+def _execute_table_free(query, params):
+    """Run permission SQL that reads no tables on a private in-memory
+    connection, on the calling thread. Returns None if the SQL needs a table."""
+    conn = getattr(_table_free, "conn", None)
+    if conn is None:
+        conn = sqlite3.connect(":memory:")
+        conn.set_authorizer(_table_free_authorizer)
+        _table_free.conn = conn
+    try:
+        return conn.execute(query, params).fetchall()
+    except sqlite3.DatabaseError:
+        return None
+
+
