+def test_request_headers_follow_scope_changes():
+    scope = {"headers": [(b"host", b"example.com"), (b"x-one", b"1")]}
+    request = Request(scope, None)
+    headers = request.headers
+    assert headers == {"host": "example.com", "x-one": "1"}
+    # Modifying the returned headers does not affect later lookups
+    headers["x-one"] = "changed"
+    assert request.headers["x-one"] == "1"
+    # Replacing request.scope, as DatasetteRouter.route_path does
+    request.scope = dict(scope, headers=[(b"host", b"other.com")])
+    assert request.headers == {"host": "other.com"}
+    assert request.host == "other.com"
+    # Modifying scope["headers"] in place
+    request.scope["headers"].append((b"x-two", b"2"))
+    assert request.headers == {"host": "other.com", "x-two": "2"}
+    request.scope["headers"][0] = (b"host", b"third.com")
+    assert request.host == "third.com"
+
