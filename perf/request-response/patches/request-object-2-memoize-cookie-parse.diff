+def _parse_cookie_header(cookie_header):
+    cookies = SimpleCookie()
+    cookies.load(cookie_header)
+    return {key: value.value for key, value in cookies.items()}
+
+
+# Browsers send the same Cookie header on every request, and the header is
+# read several times per request (router, actor_from_request, templates).
+# Longer headers are not memoized, so the memo cannot pin much memory.
+_MEMOIZED_COOKIE_HEADER_MAX_LENGTH = 8192
+_memoized_parse_cookie_header = functools.lru_cache(maxsize=128)(_parse_cookie_header)
+
