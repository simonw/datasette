+def test_request_cookies():
+    scope = {"headers": [(b"cookie", b"a=1; b=two")]}
+    request = Request(scope, None)
+    cookies = request.cookies
+    assert cookies == {"a": "1", "b": "two"}
+    # Modifying the returned cookies does not affect later lookups
+    cookies["a"] = "changed"
+    assert request.cookies == {"a": "1", "b": "two"}
+    assert Request(dict(scope), None).cookies == {"a": "1", "b": "two"}
+    request.scope = dict(scope, headers=[(b"cookie", b"c=3")])
+    assert request.cookies == {"c": "3"}
+    assert Request({}, None).cookies == {}
+    # Very long Cookie headers are parsed but not memoized
+    long_value = "x" * 10000
+    long_request = Request(
+        {"headers": [(b"cookie", f"big={long_value}".encode())]}, None
+    )
+    assert long_request.cookies == {"big": long_value}
+
+
