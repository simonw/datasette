+def test_request_args_follow_scope_changes():
+    request = Request.fake("/?a=1&a=2")
+    # Modifying the returned lists does not affect later lookups
+    request.args.getlist("a").append("3")
+    assert request.args.getlist("a") == ["1", "2"]
+    # Replacing request.scope, or modifying it in place
+    request.scope = dict(request.scope, query_string=b"b=3")
+    assert request.args._data == {"b": ["3"]}
+    request.scope["query_string"] = b"c=4"
+    assert request.args._data == {"c": ["4"]}
