+# Streamed CSV rows are collected into chunks of at least this many characters
+# so each ASGI message carries many rows rather than one
+CSV_CHUNK_SIZE = 64 * 1024
+
+
+class _ChunkedWriter:
+    def __init__(self, writer, chunk_size=CSV_CHUNK_SIZE):
+        self.writer = writer
+        self.chunk_size = chunk_size
+        self.parts = []
+        self.size = 0
+
+    async def write(self, content):
+        self.parts.append(content)
+        self.size += len(content)
+        if self.size >= self.chunk_size:
+            await self.flush()
+
+    async def flush(self):
+        chunk = "".join(self.parts)
+        self.parts = []
+        self.size = 0
+        if chunk:
+            await self.writer.write(chunk)
+
 
