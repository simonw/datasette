+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "path,expected",
+    [
+        # Infinity in a column that _shape=arrayfirst does not output - this
+        # used to fail with a 500 because the infinity scan turned the first
+        # sqlite3.Row into a list
+        ("/fixtures/-/query.json?sql=select+1+as+a,+9e999+as+b&_shape=arrayfirst", [1]),
+        ("/fixtures/infinity/1.json?_shape=arrayfirst", [1]),
+        # Infinity in the output column is still replaced with null
+        (
+            "/fixtures/-/query.json?sql=select+1+as+a+union+all+select+9e999&_shape=arrayfirst",
+            [1, None],
+        ),
+    ],
+)
+async def test_infinity_arrayfirst(ds_client, path, expected):
+    response = await ds_client.get(path)
+    assert response.status_code == 200
+    assert response.json() == expected
+
+
