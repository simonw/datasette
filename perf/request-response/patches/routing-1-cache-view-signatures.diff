+# inspect.signature() costs 5-10us, and these helpers run on every request
+# (view functions, output renderers), so cache the parameter names. Weak
+# keys so that per-request closures are not kept alive. A bound method's
+# signature depends only on its __func__, so methods are cached by that.
+_function_parameters = weakref.WeakKeyDictionary()
+_method_parameters = weakref.WeakKeyDictionary()
+
+
+def _signature_parameters(fn):
+    if type(fn) is types.FunctionType:
+        cache, key = _function_parameters, fn
+    elif type(fn) is types.MethodType and type(fn.__func__) is types.FunctionType:
+        cache, key = _method_parameters, fn.__func__
+    else:
+        return tuple(inspect.signature(fn).parameters)
+    parameters = cache.get(key)
+    if parameters is None:
+        # Computed outside of any except block, so that a signature error
+        # does not get a misleading KeyError attached as its __context__
+        parameters = cache[key] = tuple(inspect.signature(fn).parameters)
+    return parameters
+
