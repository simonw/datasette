+def _url_safe_serializer(secret, namespace):
+    # Serializers are not mutated by dumps()/loads(), so one per
+    # (secret, namespace) can be shared. Constructing them is not free:
+    # itsdangerous runs json.dumps() to detect the serializer type.
+    try:
+        return _cached_url_safe_serializer(secret, namespace)
+    except TypeError:
+        # Unhashable secret, e.g. a list of keys for itsdangerous key rotation
+        return URLSafeSerializer(secret, namespace)
+
