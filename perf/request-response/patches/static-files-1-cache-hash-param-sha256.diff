@@ -1779,6 +1779,22 @@ def sha256_file(filepath, chunk_size=4096):
     return hasher.hexdigest()
 
 
+_sha256_cache = {}
+
+
+def cached_sha256_file(filepath, chunk_size=4096):
+    # Re-hash only if the file has changed. st_ctime_ns cannot be set by
+    # tools that preserve mtime (cp -p, tar), st_ino catches replaced files
+    stat = os.stat(filepath)
+    key = (stat.st_ino, stat.st_size, stat.st_mtime_ns, stat.st_ctime_ns)
+    cached = _sha256_cache.get(filepath)
+    if cached is not None and cached[0] == key:
+        return cached[1]
+    digest = sha256_file(filepath, chunk_size=chunk_size)
+    _sha256_cache[filepath] = (key, digest)
+    return digest
+
+
 async def calculate_etag(filepath, chunk_size=4096):
     if filepath in _etag_cache:
         return _etag_cache[filepath]
