@@ -1537,6 +1538,13 @@ class Datasette:
     def static(self, path, plugin=None, mount=None):
         if plugin and mount:
             raise ValueError("Use either plugin= or mount=, not both")
+        # Resolving the path costs several filesystem calls, and templates
+        # call this for every asset on every page, so cache the result
+        cache_key = (path, plugin, mount, self.setting("base_url"))
+        if self.cache_headers:
+            cached = self._static_urls.get(cache_key)
+            if cached is not None:
+                return cached
         if plugin:
             filepath = self._static_plugin_asset_path(plugin, path)
             url = self.urls.static_plugins(plugin, path)
@@ -1547,7 +1555,11 @@ class Datasette:
             url = self.urls.static(path)
         hash_value = self._static_asset_hash(filepath)
         separator = "&" if "?" in url else "?"
-        return url + separator + urllib.parse.urlencode({"_hash": hash_value})
+        static_url = url + separator + urllib.parse.urlencode({"_hash": hash_value})
+        # Bounded in case a template passes arbitrary input to static()
+        if self.cache_headers and len(self._static_urls) < 1000:
+            self._static_urls[cache_key] = static_url
+        return static_url
 
     def _prepare_connection(self, conn, database):
         conn.row_factory = sqlite3.Row
