+def test_static_url_cached_when_cache_headers_enabled(tmp_path, monkeypatch):
+    _setup_static_app_root(tmp_path, monkeypatch, "demo.js", b"let a = 1;")
+    ds = Datasette(cache_headers=True)
+    first_url = ds.static("demo.js")
+    # Rejected paths are not cached, so they are rejected every time
+    for _ in range(2):
+        with pytest.raises(ValueError, match="cannot escape static root"):
+            ds.static("../secret.js")
+
+    def fail(path):
+        raise AssertionError("static() should have used its cache")
+
+    monkeypatch.setattr(ds, "_static_asset_path", fail)
+    assert ds.static("demo.js") is first_url
+
+
