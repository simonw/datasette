+# Small static files are served from memory, re-read if the file changes
+STATIC_FILE_CACHE_MAX_FILE_SIZE = 1024 * 1024
+STATIC_FILE_CACHE_MAX_TOTAL_SIZE = 16 * 1024 * 1024
+_static_file_cache = {}
+_static_file_cache_size = 0
+
+
+async def _cached_static_file(full_path):
+    global _static_file_cache_size
+    stat = os.stat(full_path)
+    if stat.st_size > STATIC_FILE_CACHE_MAX_FILE_SIZE:
+        return None
+    # st_ctime_ns cannot be set by tools that preserve mtime (cp -p, tar) and
+    # changes on chmod, st_ino catches files replaced by a rename
+    key = (stat.st_ino, stat.st_size, stat.st_mtime_ns, stat.st_ctime_ns)
+    cached = _static_file_cache.get(full_path)
+    if cached is not None and cached[0] == key:
+        return cached[1]
+    body = await asyncio.get_running_loop().run_in_executor(None, full_path.read_bytes)
+    if len(body) != stat.st_size:
+        # Changed while it was being read, so don't cache it
+        return body
+    # Looked up again as another request may have replaced it during the read
+    previous = _static_file_cache.get(full_path)
+    new_size = _static_file_cache_size + len(body)
+    if previous is not None:
+        new_size -= len(previous[1])
+    if new_size <= STATIC_FILE_CACHE_MAX_TOTAL_SIZE:
+        _static_file_cache[full_path] = (key, body)
+        _static_file_cache_size = new_size
+    return body
+
 
