+@pytest.mark.asyncio
+async def test_static_mounts_serve_modified_files(tmp_path, monkeypatch):
+    from datasette.utils import asgi
+
+    monkeypatch.setattr(asgi, "STATIC_FILE_CACHE_MAX_FILE_SIZE", 10)
+    (tmp_path / "small.txt").write_text("one")
+    (tmp_path / "large.txt").write_text("a large file")
+    ds = Datasette(static_mounts=[("assets", str(tmp_path))])
+    for filename, before, after in (
+        ("small.txt", "one", "three"),
+        ("large.txt", "a large file", "a larger file"),
+    ):
+        response = await ds.client.get(f"/assets/{filename}")
+        assert response.text == before
+        (tmp_path / filename).write_text(after)
+        response = await ds.client.get(f"/assets/{filename}")
+        assert response.text == after
+        assert response.headers["content-length"] == str(len(after))
+    # A same-size edit that keeps the old modification time (cp -p, tar)
+    path = tmp_path / "small.txt"
+    stat = path.stat()
+    path.write_text("four!")
+    os.utime(path, ns=(stat.st_atime_ns, stat.st_mtime_ns))
+    response = await ds.client.get("/assets/small.txt")
+    assert response.text == "four!"
+    assert asgi._static_file_cache_size == sum(
+        len(body) for _, body in asgi._static_file_cache.values()
+    )
+
+
