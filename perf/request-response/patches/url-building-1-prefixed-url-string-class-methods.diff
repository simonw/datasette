--- a/tests/test_internals_urls.py
+++ b/tests/test_internals_urls.py
@@ -149,3 +149,21 @@ def test_row(ds, ds_base_url, format, expected):
     actual = ds.urls.row("_memory", "facetable", "1", format=format)
     assert actual == expected
     assert isinstance(actual, PrefixedUrlString)
+
+
+def test_prefixed_url_string_str_methods():
+    url = PrefixedUrlString("/prefix/db/table?_size=1")
+    for value in (
+        url.replace("table", "other"),
+        url.strip("/"),
+        url + "&_sort=id",
+        *url.split("?"),
+        *url.partition("?"),
+    ):
+        assert isinstance(value, PrefixedUrlString)
+    # Methods that do not return strings are unaffected
+    assert url.startswith("/prefix/") is True
+    assert url.find("?") == 16
+    assert url.encode() == b"/prefix/db/table?_size=1"
+    assert url.maketrans("a", "b") == {97: 98}
+    assert type(str(url)) is str
